{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pa-list",
  "main": "./worker.ts",
  "compatibility_date": "2026-10-07",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
